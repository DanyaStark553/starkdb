{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "StarkDB Workbench",
  "version": "1.0.0",
  "identifier": "com.starkos.starkdb.workbench",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [
      {
        "title": "StarkDB: Ultimate Legacy (v1.0.0)",
        "url": "http://127.0.0.1:7474",
        "width": 1380,
        "height": 860,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
